{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PDF Parser",
  "version": "0.1.0",
  "identifier": "dev.albertobenatti.pdf-parser",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "PDF Parser",
        "width": 1080,
        "height": 760,
        "minWidth": 760,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
